+            response = self.client.generate(request)
+        except Exception as exc:
+            row["error"] = f"{type(exc).__name__}: {exc}"
+            raise
+        else:
+            row["response"] = asdict(response)
+            return response
+        finally:
+            with self.path.open("a", encoding="utf-8") as stream:
